{
  "id": "kinyabot-user-app",
  "name": "KinyaBot AI",
  "short_name": "KinyaBot",
  "description": "KinyaBot is Rwanda's free AI assistant. Chat in Kinyarwanda, English, French, Swahili and more. Analyze files, write code, get instant answers — powered by AFASA.",
  "start_url": "/chat/?source=pwa",
  "scope": "/chat/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#131314",
  "background_color": "#131314",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "education", "utilities"],
  "icons": [
    {
      "src": "/chat/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/chat/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/chat/web-app-manifest-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/chat/web-app-manifest-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New Chat",
      "short_name": "New Chat",
      "description": "Start a new conversation with KinyaBot",
      "url": "/chat/?new=1",
      "icons": [{ "src": "/chat/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
