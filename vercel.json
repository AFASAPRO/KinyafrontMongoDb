{
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sw.js", "destination": "/chat/sw-kill.js" },
    { "source": "/chat", "destination": "/chat/index.html" },
    { "source": "/chat/(.*)", "destination": "/chat/index.html" },
    { "source": "/admin", "destination": "/chat/index.html" },
    { "source": "/admin/:path*", "destination": "/chat/index.html" },
    { "source": "/site.webmanifest", "destination": "/chat/site.webmanifest" },
    { "source": "/admin-manifest.webmanifest", "destination": "/chat/admin-manifest.webmanifest" },
    { "source": "/logo.png", "destination": "/chat/logo.png" },
    { "source": "/logo1.png", "destination": "/chat/logo1.png" },
    { "source": "/1.png", "destination": "/chat/1.png" },
    { "source": "/auth-hero.png", "destination": "/chat/auth-hero.png" },
    { "source": "/auth-hero3.png", "destination": "/chat/auth-hero3.png" },
    { "source": "/kinyabot-hero.png", "destination": "/chat/kinyabot-hero.png" },
    { "source": "/kinyabot-hero.webp", "destination": "/chat/kinyabot-hero.webp" },
    { "source": "/favicon.ico", "destination": "/chat/favicon.ico" },
    { "source": "/favicon.svg", "destination": "/chat/favicon.svg" },
    { "source": "/favicon-96x96.png", "destination": "/chat/favicon-96x96.png" },
    { "source": "/apple-touch-icon.png", "destination": "/chat/apple-touch-icon.png" },
    { "source": "/icon-192.png", "destination": "/chat/icon-192.png" },
    { "source": "/icon-512.png", "destination": "/chat/icon-512.png" },
    { "source": "/admin-icon-192.png", "destination": "/chat/admin-icon-192.png" },
    { "source": "/admin-icon-512.png", "destination": "/chat/admin-icon-512.png" },
    { "source": "/web-app-manifest-192x192.png", "destination": "/chat/web-app-manifest-192x192.png" },
    { "source": "/web-app-manifest-512x512.png", "destination": "/chat/web-app-manifest-512x512.png" },
    { "source": "/media/kinya-mascot-auth.mp4", "destination": "/chat/media/kinya-mascot-auth.mp4" },
    { "source": "/media/kinya-mascot-auth-poster.jpg", "destination": "/chat/media/kinya-mascot-auth-poster.jpg" },
    { "source": "/rive/:path*", "destination": "/chat/rive/:path*" },
    { "source": "/models/:path*", "destination": "/chat/models/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/chat/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/chat/" }
      ]
    },
    {
      "source": "/chat/(site|admin-manifest)\\.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/chat/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
